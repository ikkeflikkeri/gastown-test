    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.33.5",
    "vite": "^6.0.5",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20"
  }
}
